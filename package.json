{
  "name": "dsh-image-tools",
  "version": "0.3.0",
  "description": "Local Qwen image editing and photography, Krea art, and cooperative GPU handoff for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averyjohnkucan-arch/dsh-image-tools.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts/*.py",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "QUALIFICATION.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js",
    "test:native": "python3 -B -m unittest discover -s test -p 'test_*.py'"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
